GOOGLE_API_KEY="your_api_key"
FRONTEND_URL="http://localhost:5173"
SESSION_SECRET="generate_a_random_secret_here"
# Enables the plugin/memory subsystem (services/memory/vector_store.py's
# MemoryService). Defaults to true here so local development exercises these
# features; render.yaml declares this var as sync:false (unset) in production,
# so production runs with plugins/memory OFF by default unless explicitly set
# in the Render dashboard. This is an intentional dev/prod difference (F7),
# not an oversight -- see EchoBot_Phase6_Master_Remediation_Plan for the
# recorded decision.
FEATURES_PLUGINS=true
