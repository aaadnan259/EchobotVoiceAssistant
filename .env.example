GOOGLE_API_KEY="your_api_key"
FRONTEND_URL="http://localhost:5173"
SESSION_SECRET="generate_a_random_secret_here"
# FEATURES_PLUGINS lets Gemini call tools (weather, Wikipedia, web search, calculator,
# time) through function calling. Defaults to true here for local development;
# render.yaml declares it sync:false (unset) so production has tools OFF unless it is
# set in the Render dashboard (F7, D10).
FEATURES_PLUGINS=true
# FEATURES_MEMORY enables ChromaDB conversation memory. Separate from the tools flag
# and off by default everywhere: it is heavy on a 512MB instance.
FEATURES_MEMORY=false
